{
  "name": "portfolio-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for Portfolio CMS",
  "scripts": {
    "dev": "sanity dev",
    "dev:network": "sanity dev --host 0.0.0.0",
    "dev:fix": "powershell -ExecutionPolicy Bypass -File ./fix-studio.ps1",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "node scripts/seed.mjs",
    "seed:win": "cross-env NODE_USE_SYSTEM_CA=1 node scripts/seed.mjs",
    "push:content": "node scripts/push-content.mjs",
    "edit:profile": "node scripts/edit-profile.mjs",
    "verify": "node scripts/verify-connection.mjs"
  },
  "dependencies": {
    "@sanity/client": "^7.22.0",
    "@sanity/vision": "^3.68.0",
    "sanity": "^3.68.0",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "win-ca": "^3.5.1"
  }
}
